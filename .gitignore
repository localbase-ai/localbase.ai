# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (NEVER commit secrets!)
env.local
.env
.env.local
.env.*.local

# Database files (contain business data)
data/**/*.db
data/**/*.db-shm
data/**/*.db-wal
data/**/*.sqlite
data/**/*.sqlite3
data/**/*.sqlite-shm
data/**/*.sqlite-wal
data/data-sources.local.json
data/sample-allowlist.json

# Keep schema documentation
!data/**/*schema.json
!data/**/*schema.sql
!data/.gitkeep
!data/data-sources.example.json
!data/sample-allowlist.example.json

# Build output
dist/
build/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Logs
logs/
*.log

# Temporary files
/tmp/
temp/
*.tmp

# Cache directories
.cache/
.npm/
.eslintcache

# OS generated files
Thumbs.db

# Test coverage
coverage/
*.lcov
.nyc_output

# Generated visualizations (instance-specific)
viz/visualizations.json
viz/*.html
# app/viz/*.html

# Connector-specific cache
connectors/**/cache/
connectors/**/.cache/

# Clay connector — contains workspace/workbook/table IDs specific to this Clay org
connectors/clay/

# Python (if using Python scripts)
__pycache__/
*.py[cod]
*$py.class
venv/
.Python

# OCR temp files
lib/ocr/temp/

# Surge deployment
surge/deployments/

# Business-specific data (IMPORTANT!)
# Add any business-specific patterns here
data/quickbooks/
data/hubspot/
data/stripe/
data/salesforce/

# MCP server runtime
mcp/server.log

# Backup files
*.bak
*.backup

# Archive files
*.zip
*.tar.gz
*.tgz

# Keep empty data directories
!data/**/.gitkeep

# Temp planning docs and test assets
.pricing.md
app/assets/test-*.gif
app/assets/vince-*.gif

# Electron temp files
electron-app/tmp/

# OAuth tokens and credentials
connectors/**/gmail_token.json
connectors/**/gmail_credentials.json
connectors/**/*.token.json
connectors/**/*_credentials.json

# Auto-generated knowledge index (instance-specific, regenerated by scripts/build-knowledge.js on startup)
/knowledge/

# Instance-specific projects (analysis, etc.)
/projects/

# Keep viz projects (presentation views)
!viz/projects/
app/.vite/

# Private banned-terms list (real instance/business names — never commit)
scripts/lib/banned-terms.local.sh

# Slash commands — DEFAULT-PRIVATE
# Often contain instance-specific examples (prospect names, HubSpot IDs, etc.).
# Allowlist generic, framework-level commands explicitly.
.claude/commands/*
!.claude/commands/research.md
!.claude/commands/start.md

# The `localbase` CLI and its Ink TUI, removed from the framework in favour of
# `scripts/start.sh`. Kept on disk (and only here) because it still runs — it
# imports tools/server/workspace-config.js by relative path, so it only works
# from this location. Backup copy: ~/Localbase/.localbase-cli-backup
bin/
tools/cli/
