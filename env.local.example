# LocalBase configuration
# Copy this file to env.local and fill in what you need. env.local is gitignored.
#
# Everything here is optional. A connector without its credentials is disabled
# rather than broken, so start with none of these and add them as you connect
# each source.

# ─── Framework ───────────────────────────────────────────────────────────────

# Where LocalBase looks for workspaces. Defaults to a "Localbase" directory in
# your home folder. Give an absolute path: the value is used exactly as written,
# so a leading ~ is not expanded and would be read as a directory literally
# named "~".
# LOCALBASE_ROOT=

# Serve on all network interfaces and accept non-local requests.
#
# LocalBase has no authentication. Its security model is that the server is
# only reachable from this machine, and setting this to true removes that with
# nothing in its place — anything that can reach the port can read and modify
# your data. If you need access from another machine, prefer an SSH tunnel or a
# reverse proxy that requires credentials. See the Security section of the
# README.
# LOCALBASE_ALLOW_REMOTE=true

# ─── Connector credentials ───────────────────────────────────────────────────
# Each connector's README lists what it needs. These are the ones the
# connectors in this repo read today.

# HubSpot — private app access token
# HUBSPOT_ACCESS_TOKEN=

# QuickBooks Online — OAuth app credentials plus the company (realm) you sync
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ACCESS_TOKEN=
# QUICKBOOKS_COMPANY_ID=
# QUICKBOOKS_ENVIRONMENT=production
# Let AI clients create/update customers (off by default)
# QUICKBOOKS_ENABLE_WRITES=true

# Slack — incoming webhook, used to post sync notifications
# SLACK_WEBHOOK_URL=

# ─── Notes ───────────────────────────────────────────────────────────────────
# - AI features do not need an API key here. Claude Code authenticates itself,
#   and reads the same local databases the dashboard does.
# - Ask Claude "help me set up the <name> connector" for a walkthrough.
